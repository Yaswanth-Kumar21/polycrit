# ===== LLM config =====
# Get a FREE key at https://console.groq.com/keys  (Groq serves openai/gpt-oss-120b free tier)
LLM_API_KEY=your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- OR use OpenAI (paid) ---
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- OR use any OpenAI-compatible provider (Together, Fireworks, Ollama, etc.) ---
# LLM_API_KEY=...
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
